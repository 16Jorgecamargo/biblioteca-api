@baseUrl = http://localhost:3000

### GET /livros lista todos [200]
GET {{baseUrl}}/livros

### GET /livros filtra por categoria [200]
GET {{baseUrl}}/livros?categoria=2

### GET /livros filtra por autor [200]
GET {{baseUrl}}/livros?autor=1

### GET /livros filtra disponiveis [200]
GET {{baseUrl}}/livros?disponivel=true

### GET /livros categoria invalida [400 REQUISICAO_INVALIDA]
GET {{baseUrl}}/livros?categoria=abc

### GET /livros disponivel invalido [400 REQUISICAO_INVALIDA]
GET {{baseUrl}}/livros?disponivel=talvez

### GET /livros/1 detalhe com autor e categoria [200]
GET {{baseUrl}}/livros/1

### GET /livros/abc id nao numerico [400 REQUISICAO_INVALIDA]
GET {{baseUrl}}/livros/abc

### GET /livros/999 inexistente [404 NAO_ENCONTRADO]
GET {{baseUrl}}/livros/999

### POST /livros cadastra e recebe id 6 [201]
POST {{baseUrl}}/livros
Content-Type: application/json

{
  "titulo": "Memorias Postumas de Bras Cubas",
  "exemplares": 2,
  "autorId": 1,
  "categoriaId": 1
}

### POST /livros corpo invalido [400 REQUISICAO_INVALIDA]
POST {{baseUrl}}/livros
Content-Type: application/json

{
  "titulo": "",
  "exemplares": 0
}

